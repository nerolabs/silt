# twocloud config — copy to config.env. Needs BOTH clouds configured. Never commit config.env.
# Credentials come from your gcloud (application-default) + aws CLI profiles, not here.

# ── GCP half (see ../cloudtest/config.env.example) ──
export PROJECT_ID="your-gcp-project-id"      # billing MUST be enabled

# ── AWS half (see ../awstest/config.env.example) ──
export AWS_REGION="us-west-2"

# ── the split (README §4). Default puts validators on BOTH clouds. Override any node:
#    SPLIT="val-c=gcp,nat-1=gcp"
export SPLIT=""

# Cost guards apply on BOTH clouds — each has a TTL self-destruct; a CERT wants
# on-demand everywhere (ALL_ON_DEMAND=1 for awstest, core_on_demand for cloudtest).
export TTL_MINUTES="180"
export BOND_MODE="fast"
