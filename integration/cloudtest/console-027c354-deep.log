                      echo "silt-startup: bootstrap ${BHOST}:${BPORT} reachable — starting silt"; break
                    fi
                    sleep 2
                  done
                fi
                
                systemctl enable --now silt.service
                echo "silt-startup: ${NODE} up — argv: ${ARGV}"
            EOT
        } [90m-> null[0m[0m
