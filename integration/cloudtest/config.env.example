# Copy to config.env and fill in. config.env is git-ignored (it names your project).
#   cp config.env.example config.env && $EDITOR config.env && ./cloudtest.sh

# ── Required ────────────────────────────────────────────────────────────────────
export PROJECT_ID="your-gcp-project-id"     # billing MUST be enabled on it

# ── Region / size ───────────────────────────────────────────────────────────────
# PRIMARY region for the cluster. The primary cluster's zone follows this
# (topology.py PRIMARY_ZONE=${REGION}-a); the secondary spread stays us-east1/europe-west1.
# A command-line `REGION=us-west1 ./cloudtest.sh` OVERRIDES this line (the caller wins).
# If us-central1-a is capacity-short, relocate here or on the command line (§F).
export REGION="us-central1"
export MACHINE_TYPE="e2-small"              # per node; e2-small ≈ cheapest that runs a FAST-mode node
export BOOT_DISK_GB="20"

# ── Bond economics (see README) ─────────────────────────────────────────────────
#   fast     — demo-sized bonds; proves the consensus/restart/NAT mechanism over the
#              real wire cheaply and fast. Default.
#   faithful — 1G+ real plotted bonds; economically faithful (C1 magnitude) but needs
#              bigger disks + real plot time. Bump MACHINE_TYPE + BOOT_DISK_GB.
export BOND_MODE="fast"

# ── Cost guards (all on by default) ─────────────────────────────────────────────
export TTL_MINUTES="180"                    # every VM self-destructs after this, no matter what
export BUDGET_AMOUNT_USD="0"                 # >0 + BILLING_ACCOUNT ⇒ create a budget-alarm backstop
export BILLING_ACCOUNT=""                    # e.g. 0123AB-4567CD-89EF01 (for the budget alarm only)

# ── SLO thresholds — DO NOT pin here (found the hard way, run 8ae8326-34086) ────
# The windows are COMPUTED bounds derived from the deployed flags (PE cadence
# ruling 2026-08-15 §4) and live in ONE place: the `: "${VAR:=…}"` defaults at the
# top of scenarios.sh, each with its derivation comment. A copied config.env that
# pinned them silently overrode the computed defaults (the re-split run graded
# publishes on a stale 120s while scenarios.sh said 240s). Export a value here
# ONLY to override a computed bound deliberately — and say why.
# COMMIT_SLO_S / FETCH_SLO_S / RESTART_SLO_S / PUBLISH_RETRY_S → scenarios.sh
# export TOKEN_QUORUM="1"                     # FIRST bootstrap run: at genesis there are no
#                                             # committed bonds to rank canonical signers, so a
#                                             # -token-quorum>=2 publish can strand the chain at
#                                             # height 0. Set 1 for the first SMOKE; raise later.

# ── Debugging ───────────────────────────────────────────────────────────────────
# export CORE_ON_DEMAND=1   # 1 = validators/registry run on-demand (non-preemptible) for a
#                           # stable RC-gate run; 0 = all-SPOT (cheapest). Defaults: 1 for a
#                           # full run, 0 for SMOKE.
# export KEEP_UP=1                           # skip teardown so you can poke at the network
