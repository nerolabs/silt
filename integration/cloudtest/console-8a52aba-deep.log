                TOKEN="$(meta service-accounts/default/token | python3 -c 'import sys,json;print(json.load(sys.stdin)["access_token"])')"
                BUCKET="${BIN_URL#gs://}"; OBJECT="${BUCKET#*/}"; BUCKET="${BUCKET%%/*}"
