                Wants=network-online.target
                
                [Service]
                Type=simple
                WorkingDirectory=/var/lib/silt
                ExecStart=/usr/local/bin/silt ${ARGV}
                Restart=on-failure
                RestartSec=2
                StandardOutput=journal
                StandardError=journal
                
                [Install]
                WantedBy=multi-user.target
                UNIT
                
