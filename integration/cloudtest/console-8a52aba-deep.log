                BOOTSTRAP_REF="$(printf '%s\n' "${ARGV}" | grep -oE -- '-bootstrap [^ ]+' | head -1 | awk '{print $2}' || true)"
                if [ "${SKIP_BOOTSTRAP_WAIT:-0}" = 1 ]; then
