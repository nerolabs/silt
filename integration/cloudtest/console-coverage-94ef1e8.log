                #!/usr/bin/env bash
                # silt node startup (rendered by Terraform templatefile; ${..} are BASH vars,
                # ${ttl_minutes} below with no $ is the Terraform-injected value).
                #
                # Fully self-configuring: the node's entire `silt` argv — with every peer ID,
