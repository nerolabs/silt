                  # table and must self-heal via the in-product -bootstrap-retry loop.
                  echo "silt-startup: ${NODE} SKIP_BOOTSTRAP_WAIT=1 — no TCP-wait; relying on in-product -bootstrap-retry self-heal (#281 wire-cert)"
