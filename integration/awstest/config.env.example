# awstest config — copy to config.env (or run `./awstest.sh setup`). Never commit config.env.
# Credentials come from your AWS CLI profile / env (aws configure or AWS_PROFILE), not here.

# PRIMARY AWS region. A command-line `AWS_REGION=eu-west-1 ./awstest.sh` OVERRIDES this
# (the caller wins — same footgun the GCP §F fix addressed). Single-region multi-AZ (v1).
export AWS_REGION="us-west-2"

# Instance size (t3.small ≈ e2-small). Bump for the faithful bond mode.
export INSTANCE_TYPE="t3.small"
export BOOT_DISK_GB="20"

# Hard cost cap: every instance self-terminates after this many minutes no matter what.
export TTL_MINUTES="180"

# Spot vs on-demand. A CERT run wants ALL_ON_DEMAND=1 (Spot preemption is fatal to a
# cert — the GCP lesson). Otherwise core roles (validator/registry/storage) stay
# on-demand and the rest are Spot.
export CORE_ON_DEMAND="true"
export ALL_ON_DEMAND="false"

# Bond economics: fast (mechanism, cheap) | faithful (economically real, bigger/slower).
export BOND_MODE="fast"
